# Copy to .env and edit. Every value below is the default unless noted.

# ---- container -----------------------------------------------------------
# readsb connects to this name:  --net-connector=mlat-server,31003,sbs_in
MLAT_CONTAINER_NAME=mlat-server
# CPU cores the server may use. 1 is plenty for the current load; raise it as
# stations are added (the server uses all it is given).
MLAT_CPUS=1
MLAT_MEM_LIMIT=4096m

# ---- port published to the host (the only one) -----------------------------
# Feeders' mlat-client connects here (TCP, and UDP if enabled below).
MLAT_CLIENT_PORT=31090

# ---- what the server listens on (inside the container) ---------------------
# Receiver connections: [host:]tcp_port[:udp_port], space separated.
# 31090 is TCP only, as the Python server is run today. Add a UDP port
# (31090:31090) to let receivers that offer the UDP transport use it.
MLAT_CLIENT_LISTEN=31090
# Kalman-filtered Basestation output for readsb. Docker-network only: the
# compose file does not publish it.
MLAT_FILTERED_LISTEN=31003
# Unfiltered Basestation output. Off: each listener costs a serialise per result.
MLAT_UNFILTERED_LISTEN=
# Connect out to a Basestation consumer instead (host:port, space separated).
MLAT_FILTERED_CONNECT=
MLAT_UNFILTERED_CONNECT=
# Rotating CSV of results (1 MB x 10 files). Path inside the container; empty = off.
MLAT_WRITE_CSV=

# aircraft.json in the work directory: a ~1 MB file rebuilt every 15 s. Nothing in the
# mlat.uk stack reads it; 0 skips the work. sync.json and clients.json are always written.
MLAT_AIRCRAFT_JSON=1

# ---- tuning ----------------------------------------------------------------
# Threads for the position engine (empty = 1) and for client connections
# (empty = min(cores, 4)). Both follow MLAT_CPUS; leave empty unless measured.
MLAT_ENGINE_THREADS=
MLAT_IO_THREADS=
# Seconds between status log lines (multiple of 15), -1 to disable.
MLAT_STATUS_INTERVAL=120
# Several servers sharing the aircraft between them: I/N (empty = single server).
MLAT_PARTITION=

# ---- identity --------------------------------------------------------------
# Shown to receivers.
MLAT_MOTD=Welcome to mlat.uk - thanks for contributing!
# AGPL: where the source of THIS server can be obtained. Set to your fork.
MLAT_SOURCE_URL=https://github.com/myromeo/mlat-server-rs

# ---- debugging -------------------------------------------------------------
# JSON-lines dump of every solver input (large!). Path inside the container.
MLAT_DUMP_PSEUDORANGE=
